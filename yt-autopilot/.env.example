# ---------------------------------------------------------------------------
# YT AutoPilot — environment file
# Copy this file to .env  (cp .env.example .env)  and fill in your values.
# ---------------------------------------------------------------------------

# Web server
PORT=3001

# Aapka time zone — daily slots isi time zone me chalte hain.
TZ=Asia/Kolkata

# Dashboard password. Public hosting par ISE ZAROOR set karo:
# refresh token isi app ke andar save hota hai.
APP_PASSWORD=
# Cookie signing secret (koi bhi lamba random string).
SESSION_SECRET=

# --- Google Cloud (OAuth client: Web application) --------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client
# Authorized redirect URI me ye daalo:
#   http://localhost:3001/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: redirect URI ko manually override karna ho to.
# GOOGLE_REDIRECT_URI=https://your-domain.com/api/google/callback

# Optional: public Drive files aur trending topics ke liye API key.
# GOOGLE_API_KEY=

# --- AI (optional) : trending title / description / tags --------------------
# OpenAI-compatible endpoint. Freebuff API key: https://freebuff.com/account/api
AI_BASE_URL=https://freebuff.com/api/v1/paid
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Where the queue, tokens and logs are stored.
# DATA_DIR=./data
